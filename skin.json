{
	"name": "Eithalica Wiki",
	"version": "0.0.1",
	"author": [
		"Peter Markley"
	],
	"url": "https://eithalica.world/lore/wiki/",
	"descriptionmsg": "eithalica-skin-desc",
	"namemsg": "skinname-eithalica",
	"license-name": "CC0-1.0",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"ValidSkinNames": {
		"eithalica": {
			"class": "SkinMustache",
			"args": [
				{
					"name": "eithalica",
					"responsive": true,
					"messages": [
						"eithalica-no-categories",
						"sitetitle",
						"search",
						"otherlanguages",
						"tagline",
						"navigation-heading"
					],
					"styles": [
						"mediawiki.ui.icon",
						"mediawiki.ui.button",
						"skins.eithalica.styles"
					],
					"scripts": [
						"skins.eithalica"
					]
				}
			]
		}
	},
	"MessagesDirs": {
		"Eithalica": [
			"i18n"
		]
	},
	"ResourceModules": {
		"skins.eithalica.styles": {
			"class": "MediaWiki\\ResourceLoader\\SkinModule",
			"features": {
				"interface": true
			},
			"targets": [
				"desktop",
				"mobile"
			],
			"styles": [
				"resources/skin.less",
				"resources/baseline.css",
				"resources/main.css",
				"resources/light_mode.css",
				"resources/dark_mode.css",
				"resources/wiki.css"
			]
		},
		"skins.eithalica": {
			"targets": [
				"desktop",
				"mobile"
			],
			"packageFiles": [
				"resources/skin.js"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "Eithalica"
	},
	"ResourceModuleSkinStyles": {
		"eithalica": {
			"+ext.echo.styles.badge": "resources/extensions/echo.styles.badge.less"
		}
	},
	"manifest_version": 2
}
